[Unit]
Description=Start the CCTV stream after boot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=oneshot
User=@USER@
Group=@USER@
Environment=HOME=@HOME@
ExecStart=/usr/local/bin/cctv boot
RemainAfterExit=yes
Restart=on-failure
RestartSec=20
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
